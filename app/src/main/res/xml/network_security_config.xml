<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Tailscale Nightscout served over plain HTTP (traffic already encrypted by Tailscale WireGuard).
             Mesh name ONLY: a raw LAN IP here would send the NS token and health data in cleartext over
             whatever Wi-Fi the phone is on, and to any host that happens to hold that address. -->
        <domain includeSubdomains="false">truenas.tailad1fba.ts.net</domain>
    </domain-config>
</network-security-config>
