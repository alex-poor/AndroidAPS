# (plugins/aps/.../camapsfx) and MUST NOT be distributed.
plugins/aps/src/main/jniLibs/
plugins/aps/src/main/java/com/camdiab/
plugins/aps/src/main/kotlin/app/aaps/plugins/aps/camapsnative/
*.decrypted.so
