<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded surface-2 panel for the overflow / popup menus, so they match the
  Compose design system (SheetSurface/AapsCard) instead of the default Material
  popup that clashed with the dark app. The inset keeps the rounded corners off
  the screen edge, as a floating card.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp"
    android:insetLeft="4dp"
    android:insetRight="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/aaps_design_surface2" />
        <corners android:radius="14dp" />
    </shape>
</inset>
